def remove_adjacent(nums):
    result = []
    for n in nums:
        if not result or result[-1] != n:
            result.append(n)
    return result

def string_mix(a, b):
    a_front = a[:(len(a) + 1) // 2]
    a_back = a[(len(a) + 1) // 2:]
    b_front = b[:(len(b) + 1) // 2]
    b_back = b[(len(b) + 1) // 2:]
    return a_front + b_front + a_back + b_back

def all_different(nums):
    return len(nums) == len(set(nums))

def bubble_sort(lst):
    n = len(lst)
    for i in range(n):
        for j in range(0, n - i - 1):
            if lst[j] > lst[j + 1]:
                lst[j], lst[j + 1] = lst[j + 1], lst[j]
    return lst

import random

def guessing_game():
    number = random.randint(1, 100)
    tries = 10
    previous = []

    while tries > 0:
        guess = int(input("guess a number (1-100): "))

        if guess < 1 or guess > 100:
            print("out of range, try again")
            continue

        if guess in previous:
            print("you already tried that number")
            continue

        previous.append(guess)
        tries -= 1

        if guess == number:
            print("correct!")
            if tries > 0:
                number = random.randint(1, 100)
                print(f"new number generated, you have {tries} tries left")
                previous = []
            else:
                print("no tries left, game over")
            return

        if guess < number:
            print("too low")
        else:
            print("too high")

    print("out of tries, the number was", number)
    again = input("play again? (yes/no): ")
    if again == "yes":
        guessing_game()

print(remove_adjacent([1,1,2,3,3]))
print(string_mix("abcde", "xyz"))
print(all_different([1,5,7,9]))
print(bubble_sort([5,3,1,4,2]))
